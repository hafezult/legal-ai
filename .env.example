# PostgreSQL / Prisma
# DATABASE_URL is used by the Prisma client at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# DIRECT_URL is used by Prisma migrations and direct database access.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk - https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Supabase document storage
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_DOCUMENT_BUCKET="legal-documents"

# AI providers
# Leave blank for local UI work without semantic retrieval.
OPENAI_API_KEY=""

# App/runtime URLs
# Used by server actions to trigger background indexing after uploads.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Internal indexing endpoint protection.
# Required outside development; use a long random value in deployed environments.
INDEXING_SECRET="change-me"
