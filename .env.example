# PostgreSQL with pgvector enabled (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk - https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Storage - create a private bucket named "legal-documents"
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
OPENAI_API_KEY=

# Internal indexing callback protection
# Required in production by /api/index-document/[documentId]
INDEXING_SECRET=

# App origin used for server-side indexing callbacks
# Defaults to http://localhost:3000 in local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
