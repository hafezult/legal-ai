# PostgreSQL with pgvector (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Storage (required for document uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=aether-documents

# OpenAI (required for embeddings and grounded research answers)
OPENAI_API_KEY=

# Internal indexing trigger
# In local development this defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=
INDEXING_SECRET=
