# PostgreSQL + pgvector (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_DOCUMENT_BUCKET="legal-documents"

# OpenAI powers embeddings and grounded research responses.
# Leave empty to run the shell without semantic retrieval.
OPENAI_API_KEY=""

# Absolute app URL used by server actions to trigger internal indexing.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required in production for POST /api/index-document/[documentId].
# Use a long random value and keep it server-side.
INDEXING_SECRET="dev-indexing-secret"
