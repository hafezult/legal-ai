# PostgreSQL with pgvector enabled (required for Prisma + retrieval)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Supabase Storage — service role key is server-only
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."

# OpenAI — leave empty to parse/chunk documents without embeddings or AI answers
OPENAI_API_KEY=""

# App URL used for server-to-server indexing callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional private override for server-side callbacks in production/VPC deployments
INTERNAL_APP_URL=""

# Shared secret for /api/index-document/[documentId].
# Required in production; optional for local development.
INDEXING_SECRET="replace-with-a-random-secret"
