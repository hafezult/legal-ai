# PostgreSQL / Prisma
# DATABASE_URL is used by the Prisma client at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# DIRECT_URL is used by Prisma migrations and direct database access.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk - https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Supabase document storage
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_DOCUMENT_BUCKET="legal-documents"

# AI providers
# Leave blank for local UI work without semantic retrieval.
OPENAI_API_KEY=""

# App/runtime URLs
# Absolute origin for invite acceptance links and email copy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional HTTP indexing endpoint protection (/api/index-document/...).
# Upload/reindex run the pipeline in-process and do not require this secret.
# Required outside development if the HTTP route is exposed: at least 32
# characters, ≥10 distinct characters, and not a trivial placeholder
# (change-me, secret, password, …). Prefer a long random value.
INDEXING_SECRET="replace-with-a-long-random-indexing-secret"

# Optional invite email delivery via Resend (https://resend.com)
# When unset, invites still work through copyable links and mailto drafts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Aether <onboarding@resend.dev>"

# Optional multi-instance rate limiting via Upstash Redis REST
# When unset, expensive actions use an in-process sliding-window limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional secret for full /api/ready probe details (x-aether-health-secret).
# When unset, INDEXING_SECRET is accepted for detailed readiness responses.
# Same strength rules as INDEXING_SECRET (≥32 chars, ≥10 distinct, non-placeholder).
# Public /api/ready always returns status + checkedAt only.
HEALTH_DETAIL_SECRET=""
